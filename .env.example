# Supabase: Project Settings → API. Nunca commitar o .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave publicável (anon) do projeto: só o servidor usa, para o login por código (Supabase Auth).
SUPABASE_ANON_KEY=
# UFs sincronizadas na Fase 1
UFS=SC,PR,RS
# Chamadas por minuto à API de consulta do PNCP (medido: 20 sem 429; 30 já dá 429)
PNCP_CONSULTA_POR_MINUTO=20
# Sal do hash de IP usado nos limites de envio do site (texto aleatório longo)
IP_SAL=
