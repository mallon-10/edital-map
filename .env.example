# Supabase: Project Settings → API. Nunca commitar o .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave publicável (anon) do projeto: só o servidor usa, para o login por código (Supabase Auth).
SUPABASE_ANON_KEY=
# UFs sincronizadas na Fase 1
UFS=SC,PR,RS
# Chamadas por minuto à API de consulta do PNCP (medido: 20 sem 429; 30 já dá 429)
PNCP_CONSULTA_POR_MINUTO=20
# Sal do hash de IP usado nos limites de envio do site (texto aleatório longo)
IP_SAL=

# Envios por e-mail (alertas às 7h e resumo de segunda; job no GitHub Actions). Resend: chave da API.
RESEND_API_KEY=
# Assina os links "Parar de receber" (texto aleatório de 32+ caracteres; o mesmo valor na Vercel, para /alertas/sair, e nos segredos do GitHub)
ALERTAS_SEGREDO=

# WhatsApp da assessoria (cartão "Quer participar desta licitação?" no edital), com DDD; vazio = cartão escondido
WHATSAPP_ASSESSORIA=
